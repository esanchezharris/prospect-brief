<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Signal watch: {{ institution }}</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  :root { --ink:#1b1b1b; --muted:#5a5a5a; --rule:#c9c4b8; --paper:#fffdf8; --accent:#7a1f1f; --card:#f6f3ec; }
  @page { size: letter landscape; margin: 0.6in; }
  html { background:#e9e6df; }
  body { margin:0; color:var(--ink); font-family:"Iowan Old Style","Palatino Linotype",Palatino,"Book Antiqua",Georgia,serif; font-size:10.5pt; line-height:1.4; }
  .page { background:var(--paper); max-width:11in; margin:24px auto; padding:0.6in; box-shadow:0 1px 6px rgba(0,0,0,.12); }
  header { border-bottom:2px solid var(--ink); padding-bottom:8px; margin-bottom:14px; }
  h1 { font-size:20pt; margin:0 0 4px; font-weight:600; }
  .meta { color:var(--muted); font-size:9.5pt; }
  .notice { font-size:9pt; color:var(--muted); border:1px solid var(--rule); padding:5px 8px; margin-top:8px; }
  table { border-collapse:collapse; width:100%; font-size:9.5pt; }
  th, td { text-align:left; vertical-align:top; padding:6px 6px; border-bottom:1px solid var(--rule); }
  th { font-size:8.5pt; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); font-weight:600; }
  td.name { font-weight:600; white-space:nowrap; }
  q { font-style:italic; color:#333; }
  .aff { color:var(--muted); font-size:9pt; }
  code { display:none; font-family:Menlo,Consolas,monospace; font-size:8.5pt; background:var(--card); border:1px solid var(--rule); padding:4px 6px; margin-top:4px; white-space:pre-wrap; word-break:break-all; }
  button.copy { display:block; margin-top:4px; font:inherit; font-size:8.5pt; color:var(--accent); background:none; border:1px solid var(--rule); padding:1px 6px; cursor:pointer; }
  tbody tr:nth-child(even) { background:#faf8f2; }
  a { color:var(--accent); }
  .form { display:inline-block; font-size:8pt; border:1px solid var(--rule); border-radius:3px; padding:0 4px; color:var(--muted); }
  .summary { margin-top:16px; padding-top:8px; border-top:1px solid var(--rule); font-size:9pt; color:var(--muted); }
  details { margin-top:14px; font-size:9pt; } details summary { cursor:pointer; color:var(--muted); }
  @media print { html{background:#fff} .page{box-shadow:none;margin:0;padding:0;max-width:none} details{display:none} code{display:block} button.copy{display:none} }
</style>
</head>
<body><div class="page">
<header>
  <h1>Signal watch: {{ institution }}</h1>
  <div class="meta">SEC filings from the last {{ days }} days mentioning “{{ institution }}” as an exact phrase · forms {{ forms|join(', ') }} · generated {{ generated_at.strftime('%B %-d, %Y %H:%M UTC') }}</div>
  <div class="notice">Public SEC EDGAR filings only. Each row is a person whose filing biography states an affiliation with the institution; the quote is verbatim from the filing and was checked in code. No CRM matching is performed: production would match these names against the CRM, this demo stops at the list. No share counts, dollar figures, or capacity estimates are computed.</div>
</header>
{% if signals %}
<table>
<thead><tr><th>#</th><th>Name</th><th>Company</th><th>Role</th><th>Event</th><th>Affiliation as stated / quote</th><th>Conf.</th><th>Filings</th></tr></thead>
<tbody>
{% for s in signals %}
<tr>
<td>{{ loop.index }}</td>
<td class="name">{{ s.person_name }}<button class="copy" type="button" onclick="navigator.clipboard.writeText(this.nextElementSibling.textContent).then(()=>{this.textContent='copied';setTimeout(()=>this.textContent='copy brief command',1200)})">copy brief command</button><code>{{ s.command }}</code></td>
<td>{{ s.company }}{% if s.ticker %} ({{ s.ticker }}){% endif %}</td>
<td>{{ s.role }}</td>
<td><span class="form">{{ s.form }}</span> {{ s.event }}</td>
<td><div class="aff">{{ s.affiliation_as_stated }}</div><q>{{ s.quote }}</q></td>
<td>{{ '%.2f'|format(s.confidence) }}</td>
<td>{% for u in s.filing_urls %}<a href="{{ u }}" target="_blank" rel="noopener">{{ loop.index }}</a>{% if not loop.last %} {% endif %}{% endfor %}</td>
</tr>
{% endfor %}
</tbody>
</table>
{% else %}
<p><em>No biographies with a stated affiliation were found in this window.</em></p>
{% endif %}
{% if dropped %}
<details><summary>{{ dropped|length }} passage{{ 's' if dropped|length != 1 }} dropped by code checks (shown for audit)</summary>
<table><thead><tr><th>Reason</th><th>Name</th><th>Company</th><th>Quote</th></tr></thead><tbody>
{% for d in dropped %}<tr><td>{{ d.drop_reason }}</td><td>{{ d.person_name }}</td><td>{{ d.company }}</td><td><q>{{ d.quote[:200] }}</q></td></tr>{% endfor %}
</tbody></table></details>
{% endif %}
<div class="summary">{{ summary.filings_searched }} filings searched, {{ summary.passages_found }} passages found, {{ summary.bios_kept }} bios kept, {{ summary.noise_dropped }} noise dropped, {{ summary.seconds }}s, estimated cost ${{ '%.2f'|format(summary.cost_usd) }}.</div>
</div></body></html>
